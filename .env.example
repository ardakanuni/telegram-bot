# Copy these values into Railway > Service > Variables.
BOT_TOKEN=PASTE_YOUR_TELEGRAM_BOT_TOKEN_IN_RAILWAY_ONLY
ADMIN_IDS=5837430827
# Optional: Telegram group/channel ID for publication-team messages.
# If empty, the current bot code sends publication messages to the first admin.
PUB_CHAT_ID=
# Set real payment card details only in Railway Variables, never in GitHub.
CARD_INFO=شماره کارت: ---- | به نام: ----
CONTACT_LINK=https://t.me/IEarduni_admin
# Attach a Railway Volume at /data, then set this variable.
DATABASE_PATH=/data/bot.db
TZ=Asia/Tehran
